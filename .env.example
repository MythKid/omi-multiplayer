# Copy this file to .env for local development. In production, set these as
# platform environment variables instead of committing a .env file.

# ----- Server -----
# Port to listen on.
PORT=3000

# development | production. Production quiets the logs, trusts the proxy for
# host checks, and shows a plain startup line instead of the LAN QR banner.
NODE_ENV=development

# Comma-separated hostnames the server will answer to. Leave empty on a LAN
# (private addresses are allowed automatically). Set it in production to lock
# the server to your domain, e.g. ALLOWED_HOSTS=omi.example.com
ALLOWED_HOSTS=

# Public base URL to advertise in join links and the QR code when deployed
# behind a proxy (Cloudflare, Koyeb). Leave empty on a LAN.
# Example: PUBLIC_URL=https://omi.example.com
PUBLIC_URL=

# Trust this many proxy hops for the real client IP and protocol. 1 suits a
# single proxy such as Cloudflare or Koyeb.
TRUST_PROXY=1

# Maximum simultaneous socket connections.
MAX_SOCKETS=16

# ----- Database (leaderboard) -----
# auto  = SQLite when the native module is available, otherwise a JSON file.
# Force a backend with: sqlite | json
DB_DRIVER=auto

# Directory where the leaderboard is stored. Point this at a persistent volume
# in production so scores survive redeploys.
DATA_DIR=./data

# Number of leaderboard rows to keep/return.
LEADERBOARD_SIZE=100

# ----- Logging -----
# error | warn | info | debug
LOG_LEVEL=info
